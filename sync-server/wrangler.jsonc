// QuickDesk Cloud sync: a Cloudflare Worker in front of one R2 bucket.
// Deploy: npm install && npx wrangler deploy (see docs/RELEASING.md).
{
  "name": "quickdesk-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "sync.quickdesk.click", "custom_domain": true }],
  "r2_buckets": [{ "binding": "SYNC", "bucket_name": "quickdesk-sync" }],
  // New sync accounts per IP address.
  "ratelimits": [{ "name": "CREATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true }
}
