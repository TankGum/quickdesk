{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickDesk",
  "version": "0.2.2",
  "identifier": "click.quickdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickDesk",
        "width": 900,
        "height": 600,
        "visible": false,
        "center": true
      },
      {
        "label": "note-popup",
        "title": "Quick note",
        "width": 480,
        "height": 140,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "clip-popup",
        "title": "Clipboard",
        "width": 520,
        "height": 420,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Quick notes, clipboard history and port manager",
    "linux": {
      "deb": {
        "postRemoveScript": "packaging/postrm.sh",
        "section": "utils"
      },
      "rpm": {
        "postRemoveScript": "packaging/postrm-rpm.sh"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "TankGum",
    "homepage": "https://github.com/TankGum/quickdesk",
    "longDescription": "Developer toolbox in the tray: quick notes with end-to-end encrypted sync, clipboard history (text, images, files), a port manager and AI usage limits."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2MzEwMDZCNDI0RjYzNDcKUldSSFkwOUNhd0F4Rmx6NFVtL1l5bDVhS2dFemN0bFFUdURQYjFPWUJTVXNrOGhZTHNJQ2dLSVIK",
      "endpoints": [
        "https://quickdesk.click/update.json",
        "https://pub-c87aab3360aa43119ac701dbe62a3688.r2.dev/update.json"
      ]
    }
  }
}
