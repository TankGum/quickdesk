{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickDesk",
  "version": "0.1.0",
  "identifier": "dev.quickdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QuickDesk",
        "width": 900,
        "height": 600,
        "visible": false,
        "center": true
      },
      {
        "label": "note-popup",
        "title": "Quick note",
        "width": 480,
        "height": 140,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      },
      {
        "label": "clip-popup",
        "title": "Clipboard",
        "width": 520,
        "height": 420,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "msi",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Quick notes, clipboard history and port manager",
    "linux": {
      "deb": {
        "postRemoveScript": "packaging/postrm.sh"
      }
    }
  }
}
