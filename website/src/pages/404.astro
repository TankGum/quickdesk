---
import Base from "../layouts/Base.astro";
import { LANGS, LANG_INFO, href, strings } from "../i18n";
// One 404 for every language (Cloudflare Pages serves 404.html for any miss):
// English, with a way to each language's home page.
const s = strings("en");
---
<Base lang="en" noindex title={s.notFound.title} description={s.notFound.description}>
  <div class="wrap wrap--narrow prose notfound">
    <p class="notfound__code">404</p>
    <h1>{s.notFound.heading}</h1>
    <div class="hero__cta">
      <a class="btn btn--primary" href="/">{s.ui.home}</a>
      <a class="btn btn--secondary" href="/docs">{s.ui.docs}</a>
    </div>
    <ul class="notfound__langs">
      {
        LANGS.filter((l) => l !== "en").map((l) => (
          <li>
            <a href={href(l, "/")} hreflang={LANG_INFO[l].tag} lang={LANG_INFO[l].tag} dir={LANG_INFO[l].dir}>
              {LANG_INFO[l].name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
