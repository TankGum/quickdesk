---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { release } from "../data/release";
import { faqPage, softwareApp } from "../data/seo";
---
<Base lang="en" title="QuickDesk — Notes, clipboard & ports for Linux and Windows" jsonLd={[softwareApp("en"), faqPage("en")]} description="QuickDesk is a free, open-source desktop helper for Linux and Windows: end-to-end encrypted notes, clipboard history, a live port manager and your AI usage limits, summoned with Super + Alt + N, V or P." wide intro>
  <Home lang="en" release={release} />
</Base>
