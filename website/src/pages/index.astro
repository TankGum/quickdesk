---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { release } from "../data/release";
import { faqPage, softwareApp } from "../data/seo";
import { strings } from "../i18n";

const lang = "en";
const p = strings(lang).pages.home;
---
<Base lang={lang} title={p.title} description={p.description} jsonLd={[softwareApp(lang), faqPage(lang)]} wide intro>
  <Home lang={lang} release={release} />
</Base>
