---
// The page in every language but English (/vi/…, /zh/…, /ar/…).
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import { release } from "../../data/release";
import { faqPage, softwareApp } from "../../data/seo";
import { LANGS, strings, type Lang } from "../../i18n";

export function getStaticPaths() {
  return LANGS.filter((l) => l !== "en").map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const p = strings(lang).pages.home;
---
<Base lang={lang} title={p.title} description={p.description} jsonLd={[softwareApp(lang), faqPage(lang)]} wide intro>
  <Home lang={lang} release={release} />
</Base>
