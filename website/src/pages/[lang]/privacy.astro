---
// The page in every language but English (/vi/…, /zh/…, /ar/…).
import Base from "../../layouts/Base.astro";
import PrivacyPage from "../../components/PrivacyPage.astro";
import { LANGS, strings, type Lang } from "../../i18n";

export function getStaticPaths() {
  return LANGS.filter((l) => l !== "en").map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const p = strings(lang).pages.privacy;
---
<Base lang={lang} title={p.title} description={p.description}>
  <PrivacyPage lang={lang} />
</Base>
