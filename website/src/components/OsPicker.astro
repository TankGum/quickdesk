---
// Linux / Windows / macOS buttons with their logos. main.js keeps every
// picker on the page in step and remembers the choice (nothing is guessed
// from the browser). macOS is always last, marked "soon" until a release has
// a Mac build and "beta" while it is in development.
import { OS_ICONS } from "../data/os-icons";
import { macBadge } from "../data/release";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
  label: string;
  class?: string;
  only?: ("linux" | "windows" | "macos")[];
}
const { lang, label, class: cls, only = ["linux", "windows"] } = Astro.props;
const names = { linux: "Linux", windows: "Windows", macos: "macOS" } as const;
const systems = [...only.filter((id) => id !== "macos"), "macos" as const];
const badge = macBadge(lang);
---
<div class:list={["ospick", cls]} role="group" aria-label={label}>
  {
    systems.map((id) => (
      <button type="button" data-os-pick={id} aria-pressed={id === "linux" ? "true" : "false"}>
        <svg class="ospick__logo" viewBox="0 0 24 24" aria-hidden="true">
          <path d={OS_ICONS[id]} fill="currentColor" />
        </svg>
        {names[id]}
        {id === "macos" && badge && <span class="ospick__soon">{badge}</span>}
      </button>
    ))
  }
</div>
