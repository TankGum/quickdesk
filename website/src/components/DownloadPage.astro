---
// /download: a tab per system (the visitor picks; nothing is guessed from the
// browser), each with its one-line install and its packages with size and
// checksum, then the release notes.
import { changelog } from "../data/changelog";
import { hasMac, macBeta, release } from "../data/release";
import { fill, href, strings, type Lang } from "../i18n";
import OsPicker from "./OsPicker.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const v = release.version;
// Non-breaking hyphens: "2026-10-09" must not wrap across lines.
const date = release.date.replaceAll("-", "‑");
const notes = changelog(lang).find((e) => e.version === v);
const f = release.files;
const t = strings(lang).download;
const vars = { v, date, beta: macBeta ? ", beta" : "" };
const s = {
  ...t,
  title: fill(t.title, vars),
  lead: fill(hasMac ? t.leadMac : t.leadSoon, vars),
  notes: fill(t.notes, vars),
};
const oneLinux = "curl -fsSL https://quickdesk.click/install.sh | bash";
const oneWindows = "irm https://quickdesk.click/install.ps1 | iex";
const unquarantine = "xattr -dr com.apple.quarantine /Applications/QuickDesk.app";
type Pkg = { kind: string; label: string; info: string[]; file: (typeof f)["deb"]; steps: string[] };
// Download and install from a terminal: one step per line, copied as one command.
const linux: Pkg[] = [
  {
    kind: "deb",
    label: ".deb",
    info: s.deb,
    file: f.deb,
    steps: [`curl -fLo /tmp/${f.deb.name} ${f.deb.href}`, `sudo apt install /tmp/${f.deb.name}`],
  },
  {
    kind: "rpm",
    label: ".rpm",
    info: s.rpm,
    file: f.rpm,
    steps: [`curl -fLo /tmp/${f.rpm.name} ${f.rpm.href}`, `sudo dnf install /tmp/${f.rpm.name}`],
  },
  {
    kind: "appimage",
    label: "AppImage",
    info: s.appimage,
    file: f.appimage,
    steps: [`curl -fLO ${f.appimage.href}`, `chmod +x ${f.appimage.name} && ./${f.appimage.name}`],
  },
];
const windows: Pkg[] = f.windows
  ? [{ kind: "windows", label: "Windows", info: s.windows, file: f.windows, steps: [oneWindows] }]
  : [];
const mac: Pkg[] = f.macos
  ? [
      {
        kind: "macos",
        label: ".dmg",
        info: s.macos,
        file: f.macos,
        // Downloaded with curl, the image is not quarantined either.
        steps: [`curl -fLo /tmp/${f.macos.name} ${f.macos.href}`, `open /tmp/${f.macos.name}`],
      },
    ]
  : [];
const systems = [
  { id: "linux", label: "Linux", one: oneLinux, oneLead: s.oneLinux, script: "/install.sh", pkgs: linux, after: s.afterLinux },
  ...(windows.length
    ? [{ id: "windows", label: "Windows", one: oneWindows, oneLead: s.oneWindows, script: "/install.ps1", pkgs: windows, after: s.afterWindows }]
    : []),
  ...(hasMac
    ? [{ id: "macos", label: "macOS", one: oneLinux, oneLead: s.oneMac, script: "/install.sh", pkgs: mac, after: s.afterMac }]
    : []),
];
---
<section class="dlpage">
  <div class="wrap">
    <header class="dlpage__head">
      <img src="/favicon.svg" alt="" width="72" height="72" />
      <h1 class="section-title">{s.title}</h1>
      <p class="lead">{s.lead}</p>
    </header>

    <OsPicker lang={lang} label={s.pick} only={systems.map((o) => o.id as "linux" | "windows" | "macos")} />

    {
      systems.map((o) => (
        <div data-os-panel={o.id} hidden={o.id !== "linux"}>
          {o.id === "macos" && macBeta && (
            <div class="macdev" role="note">
              <span class="macdev__tag">beta</span>
              <div>
                <h2>{s.devTitle}</h2>
                <p>
                  {s.devText}{" "}
                  <a class="btn--link" href="https://github.com/TankGum/quickdesk/issues">
                    {s.devLink} <span aria-hidden="true">↗</span>
                  </a>
                </p>
              </div>
            </div>
          )}
          <div class="oneline">
            <h2>{s.oneTitle}</h2>
            <div class="pkg__cmd">
              <code>{o.one}</code>
              <button type="button" class="terminal__copy" data-copy={o.one}>{s.copy}</button>
            </div>
            <p class="muted">
              {o.oneLead} <a class="btn--link" href={o.script}>{s.oneScript}</a>
            </p>
          </div>

          <h2 class="pkgs__title">{s.orPick}</h2>
          <div class="pkgs">
            {o.pkgs.map((p) => (
              <article class="pkg" data-pkg={p.kind}>
                <div class="pkg__main">
                  <h2>{p.label}</h2>
                  <p class="pkg__for">{p.info[0]}</p>
                  <p class="muted">{p.info[1]}</p>
                </div>
                <div class="pkg__get">
                  <a class="btn btn--primary" href={p.file.href} download>
                    {s.get} {p.label}
                  </a>
                  <span class="pkg__meta">v{v} · {p.file.sizeText}</span>
                </div>
                <div class="pkg__more">
                  <div class="pkg__cmd">
                    <code>{p.steps.join("\n")}</code>
                    <button type="button" class="terminal__copy" data-copy={p.steps.join(" && ")}>{s.copy}</button>
                  </div>
                  <p class="pkg__sha">
                    {s.sha}: <code>{p.file.sha256}</code>
                  </p>
                  {p.kind === "windows" && <p class="pkg__note">{s.smartscreen}</p>}
                  {p.kind === "macos" && (
                    <p class="pkg__note">
                      {s.gatekeeper} <a class="btn--link" href="#macos-open">{s.gatekeeperHow}</a>
                    </p>
                  )}
                </div>
              </article>
            ))}
          </div>
          {o.id === "macos" && (
            <div class="oneline macopen" id="macos-open">
              <h2>{s.openTitle}</h2>
              <p class="muted">{s.openLead}</p>
              <div class="macopen__ways">
                <div>
                  <h3>{s.openA}</h3>
                  <ol>
                    {s.openASteps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                  <p class="muted">{s.openOld}</p>
                </div>
                <div>
                  <h3>{s.openB}</h3>
                  <p class="muted">{s.openBLead}</p>
                  <div class="pkg__cmd">
                    <code>{unquarantine}</code>
                    <button type="button" class="terminal__copy" data-copy={unquarantine}>{s.copy}</button>
                  </div>
                </div>
              </div>
            </div>
          )}
          <p class="dlpage__after">{o.after}</p>
        </div>
      ))
    }

    {!hasMac && <div data-os-panel="macos" hidden>
      <div class="oneline oneline--soon">
        <h2>{s.macTitle}</h2>
        <p class="muted">{s.macLead}</p>
        <p>
          <a class="btn--link" href="https://github.com/TankGum/quickdesk/releases">{s.macWatch} <span aria-hidden="true">↗</span></a>
        </p>
      </div>
    </div>}

    <p class="dlpage__after">
      <a class="btn--link" href={release.checksums}>{s.all}</a>
    </p>

    {
      notes && (
        <div class="whatsnew">
          <h3>{s.notes}</h3>
          <div class="whatsnew__body" set:html={notes.html} />
          <p class="whatsnew__all">
            <a class="btn--link" href={href(lang, "/changelog")}>
              {s.allChanges} <span aria-hidden="true">›</span>
            </a>
          </p>
        </div>
      )
    }
  </div>
</section>
