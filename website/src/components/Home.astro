              <button type="button" data-close aria-label="Close"><svg viewBox="0 0 16 16"><path d="m5 5 6 6m0-6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
            </span>
          </div>
          <iframe title="QuickDesk main window (demo)" src="/demo/?window=main&amp;theme=dark" width="903" height="603"></iframe>
        </div>
