---
// Home page sections, converted from the original single-file page.
// Strings live in ../data/home.ts as { en, vi } pairs.
import DownloadCta from "./DownloadCta.astro";
import { href } from "../i18n";
import { home } from "../data/home";
import type { Lang } from "../i18n";
import type { Release } from "../data/release";

interface Props {
  lang: Lang;
  release: Release;
}
const { lang, release } = Astro.props;
const t = (key: keyof typeof home) => home[key][lang].replaceAll("{{VERSION}}", release.version).replaceAll("{{DATE}}", release.date);
---


  <!-- ============ HERO ============ -->
  <section class="hero" id="top">
    <a class="hero__new" href={href(lang, "/changelog")}>
      <span class="hero__new-tag"><Fragment set:html={t("hero-new")} /></span>
      <span>QuickDesk {release.version} — <Fragment set:html={t("hero-whatsnew")} /></span>
      <span aria-hidden="true">›</span>
    </a>
    <h1 class="hero__title"><Fragment set:html={t("t5")} /></h1>

    <!-- Motion graphic: the shortcut itself. Three 3D keys press in turn; each
         press sends out a wave in the module's colour and names the module. -->
    <div class="kb" aria-hidden="true">
      <div class="kb__floor"></div>
      <div class="kb__keys">
        <span class="kk kk--mod"><span class="kk__cap"><i>❖</i>super</span></span>
        <span class="kk__plus">+</span>
        <span class="kk kk--mod"><span class="kk__cap"><i>⌥</i>alt</span></span>
        <span class="kk__plus">+</span>
        <span class="kk kk--letter"><span class="kk__cap" data-kb-letter>N</span><span class="kk__wave"></span></span>
      </div>
      <p class="kb__label">
        <span data-kb-mod="notes"><Fragment set:html={t("kb-notes")} /></span>
        <span data-kb-mod="clipboard"><Fragment set:html={t("kb-clip")} /></span>
        <span data-kb-mod="ports"><Fragment set:html={t("kb-ports")} /></span>
      </p>
    </div>
    <div class="hero__cta">
      <a class="btn btn--primary btn--lg" href={href(lang, "/download")}><Fragment set:html={t("t7")} /></a>
      <a class="btn btn--link" href="#demo"><Fragment set:html={t("t8")} /></a>
    </div>
    <p class="hero__meta"><Fragment set:html={t("t4")} /> · Ubuntu · Debian · Fedora</p>
  </section>

  <!-- ============ INTERACTIVE DEMO ============ -->
  <section class="demo" id="demo">
    <div class="switcher" role="tablist" aria-label="QuickDesk panels">
      <button type="button" role="tab" data-mode="notes" aria-selected="false"><Fragment set:html={t("t10")} /></button>
      <button type="button" role="tab" data-mode="clipboard" aria-selected="false"><b>V</b>Clipboard</button>
      <button type="button" role="tab" data-mode="ports" aria-selected="false"><Fragment set:html={t("t11")} /></button>
      <button type="button" role="tab" data-mode="ai" aria-selected="false"><Fragment set:html={t("t12")} /></button>
    </div>
    <p class="demo__hint"><Fragment set:html={t("t13")} /></p>

    <div class="desktop" id="desktop">
      <div class="desktop__bar">
        <span class="desktop__activities"><Fragment set:html={t("t14")} /></span>
        <span class="desktop__clock" id="clock">Tue Oct 7 09:41</span>
        <span class="desktop__sys">
          <!-- QuickDesk's two tray icons, as on a real GNOME top bar -->
          <button type="button" class="desktop__tray" data-ring aria-label="AI usage ring">
            <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="none" stroke="rgba(255,255,255,.27)" stroke-width="2.4"/><circle cx="8" cy="8" r="6" fill="none" stroke="#f59e0b" stroke-width="2.4" stroke-dasharray="30.5 37.7" transform="rotate(-90 8 8)"/></svg>
          </button>
          <button type="button" class="desktop__tray" data-app-tray aria-label="QuickDesk menu">
            <img src="/assets/img/favicon.svg" alt="" width="16" height="16">
          </button>
          <span class="desktop__ime">en</span>
          <span class="desktop__quick">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 12.5a1.2 1.2 0 1 1 0 .01M3.5 8.2a6.4 6.4 0 0 1 9 0M5.4 10.2a3.7 3.7 0 0 1 5.2 0M1.6 6.2a9.2 9.2 0 0 1 12.8 0" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 6h2.5L8 3v10l-3.5-3H2z" fill="currentColor"/><path d="M10.5 5.5a3.5 3.5 0 0 1 0 5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            <svg viewBox="0 0 20 16" aria-hidden="true"><rect x="1" y="4" width="15" height="8" rx="2" fill="none" stroke="currentColor" stroke-width="1.3"/><rect x="3" y="6" width="9" height="4" rx="1" fill="currentColor"/><rect x="17" y="6.5" width="1.6" height="3" rx=".6" fill="currentColor"/></svg>
          </span>
        </span>
      </div>

      <div class="desktop__dock" aria-hidden="true">
        <i style="--c:#ff7a45"></i><i style="--c:#3a86ff"></i><i style="--c:#8338ec"></i><i style="--c:#2ec4b6"></i><i class="is-qd"><img src="/assets/img/favicon.svg" alt=""></i>
      </div>

      <p class="desktop__empty" aria-hidden="true"><Fragment set:html={t("t15")} /></p>

      <div class="desktop__stage">

        <!-- The real QuickDesk UI (npm run build:demo) running on sample data. -->
        <div class="appwin appwin--main" data-appwin="main" data-mw="560" data-mh="720" style="--w: 903px; --h: 643px">
          <div class="appwin__bar">
            <span>QuickDesk</span>
            <span class="appwin__btns">
              <button type="button" data-close aria-label="Minimise"><svg viewBox="0 0 16 16"><path d="M4.5 8.5h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
              <button type="button" aria-label="Maximise" tabindex="-1"><svg viewBox="0 0 16 16"><rect x="4.5" y="4.5" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></button>
              <button type="button" data-close aria-label="Close"><svg viewBox="0 0 16 16"><path d="m5 5 6 6m0-6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>
            </span>
          </div>
          <iframe title="QuickDesk main window (demo)" src="/demo/?window=main&amp;theme=dark" width="903" height="603"></iframe>
        </div>
        <div class="appwin appwin--popup" data-appwin="clip-popup" style="--w: 520px; --h: 420px">
          <iframe title="QuickDesk clipboard popup (demo)" src="/demo/?window=clip-popup&amp;theme=dark" width="520" height="420"></iframe>
        </div>
        <div class="appwin appwin--popup" data-appwin="note-popup" style="--w: 480px; --h: 140px">
          <iframe title="QuickDesk quick note popup (demo)" src="/demo/?window=note-popup&amp;theme=dark" width="480" height="140"></iframe>
        </div>

        <!-- The tray menus are GNOME's own menus; these copy how they look. -->
        <div class="shell-menu shell-menu--app" data-menu="app">
          <ul>
            <li data-open="note-popup"><Fragment set:html={t("t16")} /></li>
            <li data-open="notes"><Fragment set:html={t("t0")} /></li>
            <li data-open="clipboard"><Fragment set:html={t("t17")} /></li>
            <li data-open="ports"><Fragment set:html={t("t1")} /></li>
            <li class="sep"></li>
            <li class="check is-on" data-pause><Fragment set:html={t("t18")} /></li>
            <li class="sep"></li>
            <li data-open="main"><Fragment set:html={t("t19")} /></li>
            <li data-quit><Fragment set:html={t("t20")} /></li>
          </ul>
        </div>

        <div class="shell-menu shell-menu--ai" data-menu="ai">
          <ul data-tray>
            <li class="head">Claude Pro</li>
            <li data-limit><Fragment set:html={t("t21")} /></li>
            <li class="note"><Fragment set:html={t("t21b")} /></li>
            <li data-limit><Fragment set:html={t("t22")} /></li>
            <li class="note"><Fragment set:html={t("t22b")} /></li>
            <li class="sep"></li>
            <li class="sub"><Fragment set:html={t("t25")} /></li>
            <li data-refresh><Fragment set:html={t("t26")} /></li>
            <li data-limit><Fragment set:html={t("t27")} /></li>
          </ul>
        </div>

      </div>
      <div class="desktop__toast" id="toast" role="status" aria-live="polite"></div>
    </div>
  </section>

  <!-- ============ NOTES ============ -->
  <section class="feature" id="notes" style="--accent: var(--notes)">
    <div class="wrap">
      <header class="feature__head">
        <span class="shortcut"><kbd>Super</kbd><kbd>Alt</kbd><kbd>N</kbd></span>
        <p class="eyebrow eyebrow--accent"><Fragment set:html={t("t0")} /></p>
        <h2 class="section-title"><Fragment set:html={t("t28")} /></h2>
        <p class="lead"><Fragment set:html={t("t29")} /></p>
      </header>

      <div class="sync" data-sync>
        <div class="device">
          <div class="device__bar"><i></i><i></i><i></i><span>ubuntu-desktop</span></div>
          <div class="device__body"><p class="device__text" data-sync-src></p></div>
        </div>
        <div class="sync__link" aria-hidden="true">
          <span class="sync__dot"></span>
          <span class="sync__badge"><svg viewBox="0 0 12 12" aria-hidden="true"><rect x="2" y="5.2" width="8" height="5.6" rx="1.4" fill="currentColor"/><path d="M3.9 5.2V3.9a2.1 2.1 0 0 1 4.2 0v1.3" fill="none" stroke="currentColor" stroke-width="1.3"/></svg><span data-sync-badge>Encrypted &amp; synced</span></span>
        </div>
        <div class="device">
          <div class="device__bar"><i></i><i></i><i></i><span>thinkpad-x1</span></div>
          <div class="device__body"><p class="device__text" data-sync-dst></p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CLIPBOARD ============ -->
  <section class="feature" id="clipboard" style="--accent: var(--clip)">
    <div class="wrap">
      <header class="feature__head">
        <span class="shortcut"><kbd>Super</kbd><kbd>Alt</kbd><kbd>V</kbd></span>
        <p class="eyebrow eyebrow--accent">Clipboard</p>
        <h2 class="section-title"><Fragment set:html={t("t33")} /></h2>
        <p class="lead"><Fragment set:html={t("t34")} /></p>
      </header>

      <div class="stack" aria-hidden="true">
        <div class="card card--img"><span class="card__type"><Fragment set:html={t("t35")} /></span><div class="card__thumb"></div><span class="card__meta">1280×720 · 184 KB</span></div>
        <div class="card"><span class="card__type">Files</span><ul class="card__files"><li>📄 release-notes.pdf</li><li>🖼️ mockup.png</li><li>📁 assets</li></ul><span class="card__meta">~/Projects/quickdesk</span></div>
        <div class="card"><span class="card__type"><Fragment set:html={t("t36")} /></span><p class="card__text">Họp dời sang 15:30, phòng 4B</p><span class="card__meta"><Fragment set:html={t("t37")} /></span></div>
        <div class="card card--top"><span class="card__type"><Fragment set:html={t("t38")} /></span><code>docker compose up -d --build</code><span class="card__meta"><Fragment set:html={t("t39")} /></span><span class="card__pin">★</span></div>
      </div>
    </div>
  </section>

  <!-- ============ PORTS ============ -->
  <section class="feature" id="ports" style="--accent: var(--ports)">
    <div class="wrap">
      <header class="feature__head">
        <span class="shortcut"><kbd>Super</kbd><kbd>Alt</kbd><kbd>P</kbd></span>
        <p class="eyebrow eyebrow--accent"><Fragment set:html={t("t1")} /></p>
        <h2 class="section-title"><Fragment set:html={t("t43")} /></h2>
        <p class="lead"><Fragment set:html={t("t44")} /></p>
      </header>

      <div class="story" data-story>
        <div class="term">
          <div class="term__bar"><i></i><i></i><i></i><span>~/projects/web — bash</span></div>
          <pre class="term__body" data-story-term></pre>
        </div>
        <div class="mini-panel">
          <div class="mini-panel__head"><span><Fragment set:html={t("t1")} /></span><span class="shortcut shortcut--sm"><kbd>Super</kbd><kbd>Alt</kbd><kbd>P</kbd></span></div>
          <div class="ports__row ports__row--story" data-story-row><span class="port">3000</span><span>node <em>vite</em></span><span>48211</span><span class="ports__act"><button type="button" class="mini mini--danger mini--pulse" data-story-kill>Kill</button></span></div>
          <div class="ports__row ports__row--story"><span class="port">5432</span><span>🐳 postgres-dev</span><span>—</span><span></span></div>
          <div class="ports__row ports__row--story"><span class="port">6379</span><span>redis-server</span><span>1187</span><span></span></div>
          <button type="button" class="btn btn--link story__replay" data-story-replay><Fragment set:html={t("t45")} /></button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ RUNTIMES ============ -->
  <section class="feature" id="runtimes" style="--accent: var(--runtimes)">
    <div class="wrap">
      <header class="feature__head">
        <span class="shortcut"><Fragment set:html={t("rt-keys")} /></span>
        <p class="eyebrow eyebrow--accent"><Fragment set:html={t("rt-eyebrow")} /></p>
        <h2 class="section-title"><Fragment set:html={t("rt-title")} /></h2>
        <p class="lead"><Fragment set:html={t("rt-lead")} /></p>
      </header>

      <!-- The real Runtimes tab, with sample data. -->
      <div class="shot" data-shot data-mw="560" data-mh="900" style="--w: 903px; --h: 643px">
        <div class="appwin appwin--main is-static">
          <div class="appwin__bar">
            <span>QuickDesk</span>
            <span class="appwin__btns" aria-hidden="true">
              <i><svg viewBox="0 0 16 16"><path d="M4.5 8.5h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></i>
              <i><svg viewBox="0 0 16 16"><rect x="4.5" y="4.5" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></i>
              <i><svg viewBox="0 0 16 16"><path d="m5 5 6 6m0-6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></i>
            </span>
          </div>
          <iframe title="QuickDesk Runtimes tab (demo)" src={`/demo/?window=main&tab=versions&theme=dark${lang === "vi" ? "&lang=vi" : ""}`} width="903" height="603" loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AI USAGE ============ -->
  <section class="feature" id="ai" style="--accent: var(--ai)">
    <div class="wrap">
      <header class="feature__head">
        <span class="shortcut"><Fragment set:html={t("t49")} /></span>
        <p class="eyebrow eyebrow--accent"><Fragment set:html={t("t2")} /></p>
        <h2 class="section-title"><Fragment set:html={t("t50")} /></h2>
        <p class="lead"><Fragment set:html={t("t51")} /></p>
      </header>

      <!-- The real AI tab, same as the demo above. -->
      <div class="shot" data-shot data-mw="560" data-mh="900" style="--w: 903px; --h: 643px">
        <div class="appwin appwin--main is-static">
          <div class="appwin__bar">
            <span>QuickDesk</span>
            <span class="appwin__btns" aria-hidden="true">
              <i><svg viewBox="0 0 16 16"><path d="M4.5 8.5h7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></i>
              <i><svg viewBox="0 0 16 16"><rect x="4.5" y="4.5" width="7" height="7" rx="1" fill="none" stroke="currentColor" stroke-width="1.5"/></svg></i>
              <i><svg viewBox="0 0 16 16"><path d="m5 5 6 6m0-6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></i>
            </span>
          </div>
          <iframe title="QuickDesk AI usage tab (demo)" src="/demo/?window=main&amp;tab=ai&amp;theme=dark" width="903" height="603" loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>

  <DownloadCta lang={lang} release={release} />

  <!-- ============ OPEN SOURCE ============ -->
  <section class="oss">
    <div class="wrap wrap--narrow oss__inner">
      <span class="oss__mark"><svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></span>
      <h2 class="section-title center"><Fragment set:html={t("gh-title")} /></h2>
      <p class="lead center"><Fragment set:html={t("gh-lead")} /></p>
      <div class="oss__cta">
        <a class="btn btn--primary" href="https://github.com/TankGum/quickdesk"><span><Fragment set:html={t("gh-star")} /></span></a>
        <a class="btn btn--secondary" href="https://github.com/TankGum/quickdesk/issues"><Fragment set:html={t("gh-issues")} /></a>
      </div>
      <p class="oss__repo"><code>github.com/TankGum/quickdesk</code></p>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="faq" id="faq">
    <div class="wrap wrap--narrow">
      <h2 class="section-title center"><Fragment set:html={t("t80")} /></h2>
      <div class="faq__list">
        <details>
          <summary><Fragment set:html={t("t81")} /></summary>
          <p><Fragment set:html={t("t82")} /></p>
        </details>
        <details>
          <summary><Fragment set:html={t("t83")} /></summary>
          <p><Fragment set:html={t("t84")} /></p>
        </details>
        <details>
          <summary><Fragment set:html={t("t85")} /></summary>
          <p><Fragment set:html={t("t86")} /></p>
        </details>
        <details>
          <summary><Fragment set:html={t("t87")} /></summary>
          <p><Fragment set:html={t("t88")} /></p>
        </details>
        <details>
          <summary><Fragment set:html={t("t89")} /></summary>
          <p><Fragment set:html={t("t90")} /></p>
        </details>
        <details>
          <summary><Fragment set:html={t("t91")} /></summary>
          <p><Fragment set:html={t("t92")} /></p>
        </details>
        <details>
          <summary><Fragment set:html={t("t93")} /></summary>
          <p><Fragment set:html={t("t94")} /></p>
        </details>
        <details>
          <summary><Fragment set:html={t("t95")} /></summary>
          <p><Fragment set:html={t("t96")} /></p>
        </details>
        <details>
          <summary><Fragment set:html={t("t97")} /></summary>
          <p><Fragment set:html={t("t98")} /></p>
        </details>
        <details>
          <summary><Fragment set:html={t("t99")} /></summary>
          <p><Fragment set:html={t("t100")} /></p>
        </details>
      </div>
    </div>
  </section>

