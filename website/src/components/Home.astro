  <!-- ============ FAQ ============ -->
  <!-- A chat: pick a question, QuickDesk "types" and answers. The questions
       and answers are plain HTML too (shown as a list without JavaScript). -->
  <section class="faq" id="faq">
    <div class="wrap">
      <h2 class="section-title center"><Fragment set:html={t("t80")} /></h2>
      <div class="chat" data-chat>
        <div class="chat__head">
