---
// /sitemap: every page and section of the site, for people (sitemap.xml is
// the one for search engines). Built from the same data as the pages, so new
// docs sections and releases show up by themselves.
import { changelog } from "../data/changelog";
import { sectionText, sections } from "../data/docs";
import { homeText } from "../data/home";
import { privacyText } from "../data/privacy";
import { GITHUB, href, macBadge, strings, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const u = strings(lang).ui;
const strip = (html: string) => html.replace(/<[^>]+>/g, "").replace(/&amp;/g, "&");
const s = strings(lang).sitemap;
const at = (page: string, id = "") => `${href(lang, page)}${id ? `#${id}` : ""}`;
const groups = [
  {
    title: s.home,
    href: at("/"),
    links: [
      { label: s.demo, href: at("/", "demo") },
      { label: strip(homeText("t0", lang)), href: at("/", "notes") },
      { label: strip(homeText("t17", lang)), href: at("/", "clipboard") },
      { label: strip(homeText("t1", lang)), href: at("/", "ports") },
      { label: strip(homeText("rt-eyebrow", lang)), href: at("/", "runtimes") },
      { label: strip(homeText("t2", lang)), href: at("/", "ai") },
      { label: strip(homeText("t80", lang)), href: at("/", "faq") },
      { label: s.getIt, href: at("/", "download") },
    ],
  },
  {
    title: u.download,
    href: at("/download"),
    links: [
      { label: "Linux (.deb, .rpm, AppImage)", href: at("/download", "linux") },
      { label: "Windows 10 & 11", href: at("/download", "windows") },
      { label: macBadge(lang) ? `macOS (${macBadge(lang)})` : "macOS", href: at("/download", "macos") },
    ],
  },
  {
    title: u.docs,
    href: at("/docs"),
    links: sections.map((d) => ({ label: sectionText(d, lang).title, href: at("/docs", d.id) })),
  },
  {
    title: u.changelog,
    href: at("/changelog"),
    links: changelog(lang).map((e) => ({
      label: `QuickDesk ${e.version}${e.date ? ` · ${e.date}` : ""}`,
      href: at("/changelog", `v${e.version}`),
    })),
  },
  {
    title: privacyText(lang).title,
    href: at("/privacy"),
    note: s.privacyNote,
    links: [],
  },
  {
    title: s.other,
    links: [
      { label: `${u.github} ↗`, href: GITHUB },
      { label: `${u.issues} ↗`, href: `${GITHUB}/issues` },
      { label: `${s.oneLine}: install.sh`, href: "/install.sh" },
      { label: `${s.oneLine}: install.ps1`, href: "/install.ps1" },
      { label: s.machine, href: "/sitemap.xml" },
    ],
  },
];
---
<div class="wrap sitemap">
  <header class="sitemap__head">
    <h1>{s.title}</h1>
    <p class="lead">{s.lead}</p>
  </header>
  <div class="sitemap__grid">
    {
      groups.map((g) => (
        <section class="sitemap__group">
          <h2>{g.href ? <a href={g.href}>{g.title}</a> : g.title}</h2>
          {"note" in g && g.note && <p class="sitemap__note">{g.note}</p>}
          {g.links.length > 0 && (
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</div>
