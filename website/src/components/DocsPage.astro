---
import { sections } from "../data/docs";
import { href, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const title = lang === "vi" ? "Tài liệu" : "Documentation";
const lead =
  lang === "vi"
    ? "Cài đặt, phím tắt, đồng bộ, clipboard, cổng, usage AI và cập nhật."
    : "Installing, shortcuts, sync, clipboard, ports, AI usage and updates.";
const contents = lang === "vi" ? "Nội dung" : "Contents";
// Section HTML links to /download etc.; point them at this language.
const local = (html: string) => (lang === "vi" ? html.replace(/href="\/(?!vi\/)([a-z]+)"/g, 'href="/vi/$1"') : html);
---
<div class="wrap docs">
  <aside class="docs__toc" aria-label={contents}>
    <p class="docs__toc-title">{contents}</p>
    <ol>
      {sections.map((s) => <li><a href={`#${s.id}`}>{s.title[lang]}</a></li>)}
    </ol>
  </aside>
  <article class="prose">
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    {
      sections.map((s) => (
        <section id={s.id}>
          <h2>
            <a href={`#${s.id}`}>{s.title[lang]}</a>
          </h2>
          <Fragment set:html={local(s.html[lang])} />
        </section>
      ))
    }
    <p class="muted docs__more">
      {lang === "vi" ? "Còn thắc mắc?" : "Still stuck?"}{" "}
      <a href="https://github.com/TankGum/quickdesk/issues">{lang === "vi" ? "Hỏi trên GitHub" : "Ask on GitHub"}</a> ·{" "}
      <a href={href(lang, "/privacy")}>{lang === "vi" ? "Quyền riêng tư" : "Privacy"}</a>
    </p>
  </article>
</div>

<script is:inline>
  // Mark the section being read in the contents: the last one whose heading
  // has passed under the nav. On phones, keep its chip in view.
  (() => {
    const links = [...document.querySelectorAll(".docs__toc a")];
    const sections = links.map((a) => document.getElementById(a.hash.slice(1)));
    const row = document.querySelector(".docs__toc ol");
    let current = null;
    const update = () => {
      const line = window.innerWidth <= 640 ? 150 : 120;
      let i = 0;
      sections.forEach((el, k) => {
        if (el && el.getBoundingClientRect().top <= line) i = k;
      });
      // At the very bottom the last section is the one being read.
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) i = sections.length - 1;
      const a = links[i];
      if (!a || a === current) return;
      current?.removeAttribute("aria-current");
      a.setAttribute("aria-current", "true");
      current = a;
      if (row && row.scrollWidth > row.clientWidth) {
        row.scrollTo({ left: a.parentElement.offsetLeft - (row.clientWidth - a.offsetWidth) / 2, behavior: "smooth" });
      }
    };
    let queued = false;
    addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      },
      { passive: true },
    );
    addEventListener("resize", update);
    update();
  })();
</script>
