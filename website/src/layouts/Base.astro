---
// Shared page shell: head (SEO, hreflang), nav, footer.
import "../styles/site.css";
import Intro from "../components/Intro.astro";
import { OS_ICONS } from "../data/os-icons";
import { macBadge, release } from "../data/release";
import { GITHUB, href, pagePath, ui, type Lang } from "../i18n";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Wide pages (home) use the full layout; others get a reading column. */
  wide?: boolean;
  /** Not for search engines (404): no canonical, no language alternates. */
  noindex?: boolean;
  /** Structured data for this page (schema.org), besides the site's own. */
  jsonLd?: Record<string, unknown>[];
  /** Play the opening animation on a first visit (the home page). */
  intro?: boolean;
}
const { lang, title, description, wide = false, noindex = false, jsonLd = [], intro = false } = Astro.props;
const s = ui[lang];
const page = pagePath(Astro.url.pathname);
const site = Astro.site!;
const url = (l: Lang) => new URL(href(l, page), site).toString();
// The preview image when a page is shared (1200×630, one per language).
const ogImage = new URL(lang === "vi" ? "/og-vi.png" : "/og.png", site).toString();
const ogAlt = lang === "vi" ? "QuickDesk: cả bàn làm việc, chỉ cách một phím tắt." : "QuickDesk: your whole desk, one shortcut away.";
const structured = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "QuickDesk",
    url: new URL(href(lang, "/"), site).toString(),
    inLanguage: lang,
  },
  ...jsonLd,
];
// `</script>` inside a string must not end the tag.
const ldJson = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");
// The header: pages and the home-page FAQ. Download is the button on the
// right, not a link here.
const home = href(lang, "/");
const nav = [
  { href: href(lang, "/docs"), label: s.docs, current: page === "/docs", more: false },
  { href: href(lang, "/changelog"), label: s.changelog, current: page === "/changelog", more: false },
  { href: href(lang, "/privacy"), label: s.privacy, current: page === "/privacy", more: false },
  { href: `${home}#faq`, label: s.faq, current: false, more: true },
];
const icons = {
  home: "M4 11.5 12 5l8 6.5M6 10v9h4.5v-5h3v5H18v-9",
  download: "M12 4v11m-4.5-4.5L12 15l4.5-4.5M5 19h14",
  docs: "M6 4.5h9l3 3v12H6zM9 11h6M9 14.5h6M14.5 4.5V8H18",
  changelog: "M12 7v5l3 2M20 12a8 8 0 1 1-2.34-5.66M20 4v4h-4",
  privacy: "M12 3.5 19 6v5.5c0 4.2-3 7.4-7 9-4-1.6-7-4.8-7-9V6z",
  github: "M9 19c-4 1.3-4-2-6-2.5m12 4.5v-3.4a3 3 0 0 0-.8-2.3c2.8-.3 5.8-1.4 5.8-6.2a4.8 4.8 0 0 0-1.3-3.3 4.5 4.5 0 0 0-.1-3.3s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.8 2.2 5.7 2.5 5.7 2.5a4.5 4.5 0 0 0-.1 3.3 4.8 4.8 0 0 0-1.3 3.3c0 4.8 3 5.9 5.8 6.2a3 3 0 0 0-.8 2.3V21",
};
// Phones: the same places, as big type; Download is the button at the bottom.
const menu = [
  { href: home, label: s.home, icon: icons.home, current: page === "/" },
  { href: href(lang, "/docs"), label: s.docs, icon: icons.docs, current: page === "/docs" },
  { href: href(lang, "/changelog"), label: s.changelog, icon: icons.changelog, current: page === "/changelog" },
  { href: `${home}#faq`, label: s.faq, icon: icons.home, current: false },
  { href: href(lang, "/privacy"), label: s.privacy, icon: icons.privacy, current: page === "/privacy" },
  { href: GITHUB, label: s.github, icon: icons.github, current: false },
];
const ghMark =
  "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z";
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <script is:inline>
      // The theme before the first paint: the one picked with the switch,
      // else the system's (and follow the system while nothing is picked).
      (() => {
        const root = document.documentElement;
        const system = matchMedia("(prefers-color-scheme: light)");
        let picked = null;
        try {
          picked = localStorage.getItem("qd-theme");
        } catch {
          /* storage blocked: follow the system */
        }
        const apply = (t) => {
          root.dataset.theme = t;
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", t === "light" ? "#fbfbfd" : "#000000");
        };
        apply(picked === "light" || picked === "dark" ? picked : system.matches ? "light" : "dark");
        system.addEventListener("change", (e) => {
          let p = null;
          try {
            p = localStorage.getItem("qd-theme");
          } catch {}
          if (!p) apply(e.matches ? "light" : "dark");
        });
        window.qdSetTheme = (t) => {
          apply(t);
          try {
            localStorage.setItem("qd-theme", t);
          } catch {}
        };
      })();
    </script>
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <meta name="robots" content="index, follow, max-image-preview:large" />
          <link rel="canonical" href={url(lang)} />
          <link rel="alternate" hreflang="en" href={url("en")} />
          <link rel="alternate" hreflang="vi" href={url("vi")} />
          <link rel="alternate" hreflang="x-default" href={url("en")} />
        </>
      )
    }
    <meta property="og:site_name" content="QuickDesk" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url(lang)} />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "vi" ? "en_US" : "vi_VN"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {structured.map((d) => <script type="application/ld+json" set:html={ldJson(d)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Ubuntu+Sans:wght@400;500;700&display=swap"
    />
    <link rel="stylesheet" href="/assets/css/style.css" />
    {
      intro && (
        <script is:inline>
          // Before the first paint: play the intro when the home page is
          // opened from outside the site or reloaded, not when coming back
          // from another page here or through Back / Forward. Nothing is
          // stored. Never with reduced motion or for automation; "?intro"
          // forces it.
          (() => {
            const force = /[?&]intro\b/.test(location.search);
            const calm = matchMedia("(prefers-reduced-motion: reduce)").matches || navigator.webdriver;
            const nav = performance.getEntriesByType?.("navigation")[0];
            const type = nav ? nav.type : "navigate";
            let fromHere = false;
            try {
              fromHere = !!document.referrer && new URL(document.referrer).origin === location.origin;
            } catch {
              /* unreadable referrer: treat as outside */
            }
            const play = type === "reload" || (type === "navigate" && !fromHere);
            if (force || (play && !calm)) document.documentElement.classList.add("intro-play");
          })();
        </script>
      )
    }
  </head>
  <body>
    {intro && <Intro lang={lang} />}
    <a class="skip" href="#content">{s.skip}</a>
    <header class="nav" id="nav">
      <div class="nav__inner">
        <a href={href(lang, "/")} class="brand" aria-label="QuickDesk">
          <img src="/favicon.svg" alt="" width="24" height="24" />
          <span>QuickDesk</span>
        </a>
        <nav class="nav__links" aria-label="Primary">
          {
            nav.map((n) => (
              <a href={n.href} class={n.more ? "nav__more" : undefined} aria-current={n.current ? "page" : undefined}>
                {n.label}
              </a>
            ))
          }
        </nav>
        <div class="nav__end">
          <a class="nav__gh" href={GITHUB} aria-label="QuickDesk on GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d={ghMark} /></svg>
          </a>
          <button type="button" class="theme-switch" aria-label={s.theme} title={s.theme} data-theme-switch>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" /></svg>
          </button>
          <div class="lang" role="group" aria-label={s.language}>
            <a href={href("en", page)} hreflang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
            <a href={href("vi", page)} hreflang="vi" aria-current={lang === "vi" ? "true" : undefined}>VI</a>
          </div>
          <a href={href(lang, "/download")} class="btn btn--primary btn--sm nav__cta">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.download} /></svg>
            {s.download}
          </a>
          <button type="button" class="nav__menu" aria-label={s.menu} aria-controls="drawer" aria-expanded="false" data-drawer-toggle>
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <!-- Phones: the menu covers the screen, big type, nothing else. -->
    <div class="drawer" id="drawer" hidden>
      <nav class="drawer__panel" aria-label="Menu">
        <div class="drawer__head">
          <a href={href(lang, "/")} class="brand">
            <img src="/favicon.svg" alt="" width="24" height="24" />
            <span>QuickDesk</span>
          </a>
          <button type="button" class="drawer__close" aria-label={s.close} data-drawer-close>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </div>
        <ul class="drawer__main">
          {
            menu.slice(0, -1).map((m, i) => (
              <li style={`--i: ${i}`}>
                <a href={m.href} aria-current={m.current ? "page" : undefined}>
                  {m.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="drawer__meta" style={`--i: ${menu.length - 1}`}>
          <a href={GITHUB}>{s.github} <span aria-hidden="true">↗</span></a>
          <button type="button" class="drawer__theme" aria-label={s.theme} data-theme-switch>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" /></svg>
            {s.themeShort}
          </button>
          <div class="drawer__lang" role="group" aria-label={s.language}>
            <a href={href("en", page)} hreflang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
            <span aria-hidden="true">·</span>
            <a href={href("vi", page)} hreflang="vi" aria-current={lang === "vi" ? "true" : undefined}>VI</a>
          </div>
        </div>
        <div class="drawer__foot" style={`--i: ${menu.length}`}>
          <a href={href(lang, "/download")} class="btn btn--primary drawer__cta">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.download} /></svg>
            {s.download}
          </a>
          <p class="drawer__ver">QuickDesk {release.version} · Linux · Windows · macOS</p>
        </div>
      </nav>
    </div>

    <main id="content" class={wide ? "" : "page"}>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer__grid">
          <div class="footer__about">
            <a href={href(lang, "/")} class="brand footer__brand">
              <img src="/favicon.svg" alt="" width="36" height="36" />
              <span>QuickDesk</span>
            </a>
            <p class="footer__tagline">{s.tagline}</p>
            <ul class="footer__os" aria-label={s.systems}>
              {
                (["linux", "windows", "macos"] as const).map((id) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={OS_ICONS[id]} fill="currentColor" /></svg>
                    {{ linux: "Linux", windows: "Windows", macos: "macOS" }[id]}
                    {id === "macos" && macBadge(lang) && <span class="footer__soon">{macBadge(lang)}</span>}
                  </li>
                ))
              }
            </ul>
          </div>
          <nav class="footer__col" aria-label={s.product}>
            <h2>{s.product}</h2>
            <a href={href(lang, "/download")}>{s.download}</a>
            <a href={href(lang, "/docs")}>{s.docs}</a>
            <a href={href(lang, "/changelog")}>{s.changelog}</a>
          </nav>
          <nav class="footer__col" aria-label={s.project}>
            <h2>{s.project}</h2>
            <a href={GITHUB}>{s.github} <span aria-hidden="true">↗</span></a>
            <a href={`${GITHUB}/issues`}>{s.issues} <span aria-hidden="true">↗</span></a>
            <a href={href(lang, "/privacy")}>{s.privacy}</a>
            <a href={href(lang, "/sitemap")}>{s.sitemap}</a>
          </nav>
          <div class="footer__col">
            <h2>{s.language}</h2>
            <div class="footer__lang" role="group" aria-label={s.language}>
              <a href={href("en", page)} hreflang="en" aria-current={lang === "en" ? "true" : undefined}>English</a>
              <a href={href("vi", page)} hreflang="vi" aria-current={lang === "vi" ? "true" : undefined}>Tiếng Việt</a>
            </div>
          </div>
        </div>
        <div class="footer__bottom">
          <p>© <span id="year">2026</span> {s.footer}</p>
          <p>QuickDesk {release.version} · {release.date}</p>
        </div>
      </div>
      <p class="footer__mark" aria-hidden="true">QuickDesk</p>
    </footer>

    <script is:inline>
      // Light / dark switch (the header and the phone menu).
      document.querySelectorAll("[data-theme-switch]").forEach((b) =>
        b.addEventListener("click", () => window.qdSetTheme(document.documentElement.dataset.theme === "light" ? "dark" : "light")),
      );
      // Phone menu: covers the screen; × and Escape close it.
      (() => {
        const drawer = document.getElementById("drawer");
        const button = document.querySelector("[data-drawer-toggle]");
        let closing;
        const isOpen = () => drawer.classList.contains("is-open");
        const open = () => {
          clearTimeout(closing);
          drawer.hidden = false;
          // Read layout once so the transition starts from the closed state.
          void drawer.offsetHeight;
          drawer.classList.add("is-open");
          button.setAttribute("aria-expanded", "true");
          document.documentElement.classList.add("drawer-open");
          drawer.querySelector(".drawer__close").focus({ preventScroll: true });
        };
        const close = () => {
          if (!isOpen()) return;
          drawer.classList.remove("is-open");
          button.setAttribute("aria-expanded", "false");
          document.documentElement.classList.remove("drawer-open");
          button.focus({ preventScroll: true });
          closing = setTimeout(() => (drawer.hidden = true), 340);
        };
        button.addEventListener("click", () => (isOpen() ? close() : open()));
        drawer.querySelectorAll("[data-drawer-close]").forEach((el) => el.addEventListener("click", close));
        // Places on the home page do not load a new page: close on the way.
        drawer.querySelectorAll(".drawer__main a").forEach((a) => a.addEventListener("click", close));
        document.addEventListener("keydown", (e) => e.key === "Escape" && close());
        matchMedia("(min-width: 641px)").addEventListener("change", (e) => e.matches && close());
      })();
    </script>
    <script is:inline src="/assets/js/main.js" defer></script>
  </body>
</html>
